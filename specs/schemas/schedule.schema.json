{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walls.utkarshjoshi.com/specs/schemas/schedule.schema.json",
  "title": "Wallpaper schedule v1",
  "description": "Proposed contract. Ownership, timezone validity, window overlap, time ordering, and playlist eligibility also require domain validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "timezone", "sync_time", "default_playlist_id", "default_interval_minutes", "default_order", "windows"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
    "sync_time": {"$ref": "#/$defs/localTime"},
    "default_playlist_id": {"type": "string", "format": "uuid"},
    "default_interval_minutes": {"type": "integer", "minimum": 15, "maximum": 1440},
    "default_order": {"enum": ["ordered", "shuffle"]},
    "windows": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/window"}
    }
  },
  "$defs": {
    "localTime": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "endTime": {"type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "days", "start", "end", "playlist_id", "interval_minutes", "order"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "days": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "start": {"$ref": "#/$defs/localTime"},
        "end": {"$ref": "#/$defs/endTime"},
        "playlist_id": {"type": "string", "format": "uuid"},
        "interval_minutes": {"type": "integer", "minimum": 15, "maximum": 1440},
        "order": {"enum": ["ordered", "shuffle"]}
      }
    }
  }
}
