{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walls.utkarshjoshi.com/specs/schemas/schedule.schema.json",
  "title": "Collection rotation preferences v1 (unreleased draft)",
  "description": "Persisted preferences, mostly generated at onboarding. The UI edits collection_ids, mode and cadence; sync_window is secondary. Identity/revision/timezone are server-managed. Empty selection stops rotation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "timezone",
    "collection_ids",
    "mode",
    "cadence",
    "sync_window"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "collection_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "mode": {
      "enum": [
        "shuffle",
        "sequential"
      ],
      "default": "shuffle"
    },
    "cadence": {
      "enum": [
        "hourly",
        "every_3_hours",
        "daily"
      ],
      "default": "hourly"
    },
    "sync_window": {
      "enum": [
        "morning",
        "night"
      ],
      "default": "night"
    }
  }
}
