# Settings for the `walls` catalog service.
#
# Copy this file to `.env` (same folder) and fill it in. `walls` reads `.env`
# from the folder you run it in; real environment variables win over the file.
# `.env` is git-ignored. Never commit real keys.

# Address the HTTP API listens on.
WALLS_ADDR=:8787

# Folder for runtime output: the SQLite catalog (catalog.db) and, with local
# storage, the stored files (objects/).
WALLS_DATA_DIR=./data

# Where image and video files are kept: "local" (a folder under
# WALLS_DATA_DIR) or "s3" (any S3-compatible bucket, e.g. Oracle Cloud).
WALLS_STORAGE=local

# --- Only needed when WALLS_STORAGE=s3 ---------------------------------------
# Oracle Cloud Object Storage, S3 compatibility API:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# No bucket name and no trailing path in the endpoint.
WALLS_S3_ENDPOINT=
# The bucket's region, e.g. ap-mumbai-1.
WALLS_S3_REGION=
# Bucket name. The bucket stays private; clients get short-lived signed links.
WALLS_S3_BUCKET=walls-assets
# An OCI "Customer Secret Key" pair (Profile → Customer secret keys).
WALLS_S3_ACCESS_KEY=
WALLS_S3_SECRET_KEY=

# Browser origins allowed to call the API, comma-separated. The defaults cover
# the Vite dev server and the Tauri desktop shell. "*" allows any origin.
WALLS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# Optional. If set, file links in API responses are absolute
# (https://walls.example.com/v1/files/...) instead of relative (/v1/files/...).
WALLS_PUBLIC_URL=

# Optional. The owner's password for the admin portal at /admin (sign-ups,
# activity, wallpaper list). At least 12 characters; use a long random one,
# for example the output of `openssl rand -base64 24`. Left empty, the portal
# is switched off and /v1/admin answers 404. Changing it signs everyone out.
WALLS_ADMIN_PASSWORD=

# --- Signing in to the app ----------------------------------------------------
# People sign in with a six-digit code emailed to them; there are no passwords.
# The code goes out through a mail relay: any provider that gives you an SMTP
# host, a user name and a password (Resend, Brevo, Amazon SES, Oracle Cloud
# Email Delivery, ...). Leave WALLS_SMTP_HOST empty and signing in is switched
# off; everything else works as before.
WALLS_SMTP_HOST=
# 587 (the default) upgrades the connection with STARTTLS; 465 is encrypted
# from the start. Nothing is ever sent over an unencrypted connection.
WALLS_SMTP_PORT=587
WALLS_SMTP_USER=
WALLS_SMTP_PASSWORD=
# The address codes come from. The relay must be allowed to send as it, which
# usually means verifying the domain with them first.
#   WALLS_MAIL_FROM=Still <hello@example.com>
WALLS_MAIL_FROM=

# Development only. Writes each message to the server log instead of sending
# it, so sign-in can be tried without a mail account. Never set this on a
# server other people can reach: whoever can read the log can sign in as anyone.
# WALLS_MAIL_TO_LOG=1

# Storage budget in bytes. `seed` and `ingest` refuse to store anything that
# would take the catalog's total above this. Default: 7 GB.
WALLS_STORAGE_CAP_BYTES=7000000000
