# Caddy in front of the catalog service, also serving the product page.
#
# Cloudflare sits in front of this server and decides whether visitors use
# http or https, so nothing here redirects between the two (doing so would
# loop when Cloudflare talks to this server over plain http).
{
	auto_https disable_redirects
}

(catalog) {
	encode zstd gzip

	# The catalog service: everything the app asks for lives under /v1.
	handle /v1/* {
		reverse_proxy api:8787
	}

	# Everything else is the product page (apps/site, built and uploaded by
	# deploy.sh). Until it has been uploaded, these addresses answer 404.
	handle {
		root * /srv/site

		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin

		# The page may load only its own files.
		@page not path /media/scenes/*
		header @page Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

		# The live scenes the page shows are the catalog's own scene files.
		# Each already carries this policy inside it (docs/16); sending it as
		# a header too, with `sandbox`, means a scene opened directly still
		# cannot touch the rest of the site.
		@scene path /media/scenes/*
		header @scene Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts"

		# Built files have their content in their name and never change;
		# pictures and scenes may be replaced by a later upload.
		@built path /assets/*
		header @built Cache-Control "public, max-age=31536000, immutable"
		@media path /media/*
		header @media Cache-Control "public, max-age=86400"

		file_server
	}
}

# Plain http: what Cloudflare uses in "Flexible" mode.
http:// {
	import catalog
}

# https: what Cloudflare uses in "Full" mode. Caddy asks for a public
# certificate first (required by "Full (strict)") and otherwise uses one it
# signs itself, so this always answers.
https://{$WALLS_DOMAIN} {
	tls {
		issuer acme
		issuer internal
	}
	import catalog
}
