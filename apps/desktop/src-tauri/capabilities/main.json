{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the Still window may do. Live wallpaper windows (live-*) are deliberately absent: they get no commands at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-displays-list",
    "allow-library-store",
    "allow-library-download",
    "allow-library-remove",
    "allow-library-resolve",
    "allow-wallpaper-apply",
    "allow-rotation-sync",
    "allow-rotation-command",
    "allow-rotation-status"
  ]
}
