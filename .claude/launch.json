{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "still-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "still-api",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "-C",
        "apps/api",
        "./cmd/walls",
        "serve"
      ],
      "port": 8787
    },
    {
      "name": "still-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/site",
        "run",
        "dev"
      ],
      "port": 5180
    }
  ]
}
